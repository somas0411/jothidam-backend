# .env.example — every setting of the backend. Copy to .env for local use;
# on Render, enter them under Environment. Never commit real values.

# ── Existing settings ─────────────────────────────────────────────────────────
# RATE_LIMIT_ENABLED=true
# CLIENT_IP_HEADER=CF-Connecting-IP
# EXTRA_ORIGINS=https://deploy-preview-12--horoscopesgen.netlify.app

# ── Astrologer booking: database (required for booking) ───────────────────────
# Free PostgreSQL from Neon (or Supabase). Without it the booking routes answer 503
# and the rest of the API works as before.
# The password goes in DATABASE_PASSWORD, kept out of the address. Use Neon's
# production branch with Connection pooling OFF (no "-pooler" in the host).
DATABASE_URL=postgresql://neondb_owner@ep-xxxx.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_PASSWORD=

# Secret used to make each booking's private link. Any long random string;
# changing it makes existing manage/cancel links stop working.
#   python -c "import secrets; print(secrets.token_hex(32))"
BOOKING_SECRET=

# Key for the admin page (admin.html) and /api/admin/*. At least 16 characters.
# Leave empty to switch the admin routes off.
ADMIN_API_KEY=

# Addresses written into e-mails and calendar entries.
SITE_URL=https://horoscopegen.in
PUBLIC_API_URL=https://jothidam-backend.onrender.com

# Booking rules (defaults shown)
# BOOKING_WINDOW_DAYS=30     how many days ahead a slot may be booked
# BOOKING_LEAD_HOURS=2       earliest slot = now + this many hours
# RETENTION_DAYS=90          personal data is wiped this long after the appointment
# NOTIFY_WORKER=true         background e-mail sender in the web process

# ── Astrologer booking: e-mail (one provider; with none, e-mails are only logged) ──
EMAIL_FROM=HoroscopeGen <bookings@horoscopegen.in>

# Resend (recommended: free 3,000 a month, 100 a day; sends over HTTPS, so it
# works on Render's free plan, which blocks SMTP)
RESEND_API_KEY=

# Brevo
BREVO_API_KEY=

# Or any SMTP server (needs a paid Render instance: the free one blocks SMTP)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ── Switches ─────────────────────────────────────────────────────────────────
# AI_TABS_ENABLED=false     true brings back the AI_ sheets, the Notes section on them and /api/download/json

# ── Paid reports (payments.py). OFF until the LLP and Razorpay KYC are done ──
# Going live: fill the Razorpay keys and PAYMENT_SECRET, then PAYMENTS_ENABLED=true.
# Needs DATABASE_URL (orders are stored). With it false every download stays free.
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Signs the download links. Any long random string:  python -c "import secrets; print(secrets.token_hex(32))"
PAYMENT_SECRET=
# Prices in paise (INR only). 20000 = ₹200
# PRICE_BASIC_PAISE=20000     horoscope without Notes / Predictions
# PRICE_FULL_PAISE=50000      horoscope with Notes (குறிப்புகள்) and Predictions (பலன்கள்)
# PRICE_MATCH_PAISE=20000     marriage matching report
# PRICE_FAMILY_PAISE=50000    family reading report
# PAYMENT_LINK_HOURS=72       how long the paid download links work

# ── Support tickets (tickets.py; needs DATABASE_URL) ─────────────────────────
# Tickets are e-mailed here; also the reply-to of receipts.
SUPPORT_EMAIL=

# ── Tests only ────────────────────────────────────────────────────────────────
# TEST_DATABASE_URL=postgresql://postgres@localhost/hg_test   runs tests/test_bookings.py on PostgreSQL
