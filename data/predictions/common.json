  "hm.1": {"en": "self, confidence and direction in life", "ta": "சுயம், தன்னம்பிக்கை, வாழ்க்கைப் போக்கு"},
  "hm.2": {"en": "family, speech and savings", "ta": "குடும்பம், பேச்சு, சேமிப்பு"},
  "hm.3": {"en": "courage, effort, siblings and short travel", "ta": "தைரியம், முயற்சி, உடன்பிறப்புகள், குறுகிய பயணம்"},
  "hm.4": {"en": "home, mother, property, vehicles and peace of mind", "ta": "வீடு, தாய், சொத்து, வாகனம், மன அமைதி"},
  "hm.5": {"en": "children, studies, intelligence and investments", "ta": "குழந்தைகள், கல்வி, அறிவு, முதலீடுகள்"},
  "hm.6": {"en": "service, competition, loans and daily work", "ta": "சேவை, போட்டி, கடன், அன்றாடப் பணி"},
  "hm.7": {"en": "marriage, partnerships and public dealings", "ta": "திருமணம், கூட்டாண்மை, பொதுத் தொடர்புகள்"},
  "hm.8": {"en": "sudden changes, research, inheritance and hidden matters", "ta": "திடீர் மாற்றங்கள், ஆராய்ச்சி, பரம்பரைச் சொத்து, மறைவான விஷயங்கள்"},
  "hm.9": {"en": "fortune, father, teachers and higher learning", "ta": "பாக்கியம், தந்தை, குருமார், உயர்கல்வி"},
  "hm.10": {"en": "career, status and actions", "ta": "தொழில், அந்தஸ்து, செயல்கள்"},
  "hm.11": {"en": "gains, income, friends and wishes", "ta": "லாபம், வருமானம், நண்பர்கள், விருப்பங்கள்"},
  "hm.12": {"en": "expenses, foreign lands, rest and spiritual release", "ta": "செலவுகள், வெளிநாடு, ஓய்வு, ஆன்மீக விடுதலை"},

  "sig.Sun": {"en": "authority, father, government and self-respect", "ta": "அதிகாரம், தந்தை, அரசு, சுயமரியாதை"},
  "sig.Moon": {"en": "mind, mother, the public and emotions", "ta": "மனம், தாய், பொதுமக்கள், உணர்வுகள்"},
  "sig.Mars": {"en": "energy, courage, land and siblings", "ta": "சக்தி, தைரியம், நிலம், உடன்பிறப்புகள்"},
  "sig.Mercury": {"en": "intellect, communication, trade and calculation", "ta": "அறிவு, தொடர்பு, வணிகம், கணக்கு"},
  "sig.Jupiter": {"en": "wisdom, children, guidance and wealth", "ta": "ஞானம், குழந்தைகள், வழிகாட்டல், செல்வம்"},
  "sig.Venus": {"en": "comfort, marriage, arts and vehicles", "ta": "சுகம், திருமணம், கலைகள், வாகனங்கள்"},
  "sig.Saturn": {"en": "discipline, hard work, service and endurance", "ta": "ஒழுக்கம், கடின உழைப்பு, சேவை, பொறுமை"},
  "sig.Rahu": {"en": "ambition, foreign links and technology", "ta": "லட்சியம், வெளிநாட்டுத் தொடர்பு, தொழில்நுட்பம்"},
  "sig.Ketu": {"en": "detachment, research and spirituality", "ta": "பற்றின்மை, ஆராய்ச்சி, ஆன்மீகம்"},

  "sn.1": {"en": "active and direct", "ta": "சுறுசுறுப்பான, நேரடியான"},
  "sn.2": {"en": "steady and comfort-loving", "ta": "நிலையான, சுகத்தை விரும்பும்"},
  "sn.3": {"en": "talkative and curious", "ta": "பேச்சுத் திறனுள்ள, ஆர்வமுள்ள"},
  "sn.4": {"en": "caring and emotional", "ta": "அக்கறையுள்ள, உணர்ச்சிமிக்க"},
  "sn.5": {"en": "confident and dignified", "ta": "தன்னம்பிக்கையுள்ள, கௌரவமான"},
  "sn.6": {"en": "practical and detail-minded", "ta": "நடைமுறை அறிவுள்ள, நுணுக்கமான"},
  "sn.7": {"en": "balanced and sociable", "ta": "சமநிலையான, எளிதில் பழகும்"},
  "sn.8": {"en": "intense and determined", "ta": "தீவிரமான, உறுதியான"},
  "sn.9": {"en": "principled and optimistic", "ta": "கொள்கைப் பிடிப்புள்ள, நம்பிக்கையுள்ள"},
  "sn.10": {"en": "responsible and hardworking", "ta": "பொறுப்புள்ள, உழைப்பாளியான"},
  "sn.11": {"en": "independent and idealistic", "ta": "சுதந்திரமான, இலட்சியமுள்ள"},
  "sn.12": {"en": "gentle and imaginative", "ta": "மென்மையான, கற்பனைத் திறனுள்ள"},

  "pn.Sun": {"en": "self-respecting and leading", "ta": "சுயமரியாதையும் தலைமைப் பண்பும்"},
  "pn.Moon": {"en": "caring and sensitive", "ta": "அக்கறையும் மென்மையும்"},
  "pn.Mars": {"en": "energetic and frank", "ta": "சுறுசுறுப்பும் வெளிப்படையும்"},
  "pn.Mercury": {"en": "youthful and witty", "ta": "இளமையும் நகைச்சுவை உணர்வும்"},
  "pn.Jupiter": {"en": "wise and well-meaning", "ta": "ஞானமும் நல்லெண்ணமும்"},
  "pn.Venus": {"en": "refined and affectionate", "ta": "நாகரிகமும் அன்பும்"},
  "pn.Saturn": {"en": "mature and dependable", "ta": "முதிர்ச்சியும் நம்பகத்தன்மையும்"},
  "pn.Rahu": {"en": "unconventional and ambitious", "ta": "வழக்கத்திற்கு மாறான, லட்சியமுள்ள தன்மை"},
  "pn.Ketu": {"en": "quiet and introspective", "ta": "அமைதியும் அகநோக்கும்"}
}
